<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="BuildInstaller">
  <PropertyGroup>
    <Root>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</Root>
    <InstallerTemp Condition="'$(InstallerTemp)' == ''">$(Root)\InstallerTemp</InstallerTemp>
    <BuildDir Condition="'$(BuildDir)' == ''">$(Root)\Output</BuildDir>
    <Lib Condition="'$(Lib)' == ''">$(Root)\Lib</Lib>
    <WixBin Condition="'$(WixBin)' == ''">$([MSBuild]::EnsureTrailingSlash('$(WIX)'))bin\</WixBin>
  </PropertyGroup>

  <Import Project="get_git_version.xml" />

  <Target Name="BuildInstaller" DependsOnTargets="CheckWix;Clean;CopyInstallerFiles;GetGitVersion;Harvest;Candle;Light" />

  <Target Name="CheckWix">
    <Error Text="WiX Toolset v3 not found in '$(WixBin)'. Install it or set the WIX environment variable." Condition="!Exists('$(WixBin)candle.exe')" />
    <Error Text="'$(BuildDir)' does not exist, run build_output.xml first." Condition="!Exists('$(BuildDir)')" />
  </Target>

  <Target Name="Clean">
    <RemoveDir Directories="$(InstallerTemp)" />
  </Target>

  <Target Name="CopyInstallerFiles">
    <ItemGroup>
      <InstallerFiles Include="$(MSBuildThisFileDirectory)Main.wxs;
                               $(MSBuildThisFileDirectory)License.rtf;
                               $(Root)\FreePIE.GUI\free-pie.ico;
                               $(Lib)\VC++\*.msm" />
    </ItemGroup>
    <Copy SourceFiles="@(InstallerFiles)" DestinationFolder="$(InstallerTemp)" />
  </Target>

  <Target Name="Harvest">
    <Exec WorkingDirectory="$(InstallerTemp)" Command="&quot;$(WixBin)heat.exe&quot; dir &quot;$(BuildDir)&quot; -sreg -nologo -suid -srd -sfrag -ag -wx -dr INSTALLFOLDER -var var.OutputDir -cg Output -out Output.wxs" />
  </Target>

  <Target Name="Candle">
    <Exec WorkingDirectory="$(InstallerTemp)" Command="&quot;$(WixBin)candle.exe&quot; -nologo -ext WiXNetFxExtension -dOutputDir=&quot;$(BuildDir)&quot; -dVersion=&quot;$(Version)&quot; -dProductName=&quot;FreePIE&quot; Main.wxs Output.wxs" />
  </Target>

  <Target Name="Light">
    <Exec WorkingDirectory="$(InstallerTemp)" Command="&quot;$(WixBin)light.exe&quot; -nologo -ext WixUIExtension -ext WiXNetFxExtension -out FreePIE.$(Version).msi Main.wixobj Output.wixobj" />
    <Message Importance="high" Text="Installer: $(InstallerTemp)\FreePIE.$(Version).msi" />
  </Target>
</Project>
