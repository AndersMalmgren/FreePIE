<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="WriteVersion">

  <Import Project="get_git_version.xml" />

  <!-- Only write when the version changes, otherwise every build recompiles all projects that link VersionInfo.cs -->
  <Target Name="WriteVersion" DependsOnTargets="GetGitVersion">
    <ItemGroup>
      <VersionInfoLine Include="using System.Reflection%3B" />
      <VersionInfoLine Include="[assembly: AssemblyVersion(&quot;$(Version)&quot;)]" />
      <VersionInfoLine Include="[assembly: AssemblyFileVersion(&quot;$(Version)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\VersionInfo.cs" Lines="@(VersionInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
