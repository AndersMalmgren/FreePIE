<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <MajorVersion>1.12</MajorVersion>
  </PropertyGroup>

  <Target Name="GetGitVersion">
    <!-- Run from the repository root so the git on PATH is used, not the old git.exe in BuildTools -->
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory).." ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <Warning Text="Could not get the git commit count, using 0" Condition="'$(GitExitCode)' != '0'" />
    <PropertyGroup>
      <GitCommitCount Condition="'$(GitExitCode)' != '0'">0</GitCommitCount>
      <Version>$(MajorVersion).$(GitCommitCount).0</Version>
    </PropertyGroup>
  </Target>
</Project>
